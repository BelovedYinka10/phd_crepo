        <mxCell id="v0K_z04Gsabg1yHkljTw-3" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;h3 data-start=&quot;1056&quot; data-end=&quot;1082&quot;&gt;&lt;strong data-start=&quot;1060&quot; data-end=&quot;1080&quot;&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;1) The gcd (&lt;code data-start=&quot;1074&quot; data-end=&quot;1077&quot;&gt;d&lt;/code&gt;)&lt;/font&gt;&lt;/strong&gt;&lt;span style=&quot;font-size: 15px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-weight: normal;&quot;&gt;.&lt;/span&gt;&lt;/h3&gt;&lt;p data-start=&quot;1083&quot; data-end=&quot;1166&quot;&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;&lt;br&gt;This checks whether a solution exists.&lt;br data-start=&quot;1128&quot; data-end=&quot;1131&quot;&gt;&lt;br&gt;If &lt;code data-start=&quot;1134&quot; data-end=&quot;1142&quot;&gt;d != 1&lt;/code&gt;, Falcon rejects &lt;code data-start=&quot;1159&quot; data-end=&quot;1165&quot;&gt;f, g&lt;/code&gt;.&lt;/font&gt;&lt;/p&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;h3 data-start=&quot;1168&quot; data-end=&quot;1216&quot;&gt;&lt;strong data-start=&quot;1172&quot; data-end=&quot;1214&quot;&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;2) The Bézout coefficients &lt;code data-start=&quot;1201&quot; data-end=&quot;1204&quot;&gt;u&lt;/code&gt; and &lt;code data-start=&quot;1209&quot; data-end=&quot;1212&quot;&gt;v&lt;/code&gt;&lt;/font&gt;&lt;/strong&gt;&lt;/h3&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;&lt;span class=&quot;base&quot;&gt;&lt;span class=&quot;mord mathnormal&quot;&gt;u&lt;/span&gt;&lt;span class=&quot;mord&quot;&gt;&lt;span class=&quot;mord mathnormal&quot;&gt;f&lt;/span&gt;&lt;span class=&quot;msupsub&quot;&gt;&lt;span class=&quot;vlist-t vlist-t2&quot;&gt;&lt;span class=&quot;vlist-r&quot;&gt;&lt;span class=&quot;vlist&quot;&gt;&lt;span class=&quot;pstrut&quot;&gt;&lt;/span&gt;&lt;span class=&quot;sizing reset-size6 size3 mtight&quot;&gt;&lt;span class=&quot;mord mtight&quot;&gt;0&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span class=&quot;vlist-s&quot;&gt;​&lt;/span&gt;&lt;/span&gt;&lt;span class=&quot;vlist-r&quot;&gt;&lt;span class=&quot;vlist&quot;&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span class=&quot;mspace&quot;&gt;&lt;/span&gt;&lt;span class=&quot;mbin&quot;&gt;+&lt;/span&gt;&lt;span class=&quot;mspace&quot;&gt;&lt;/span&gt;&lt;/span&gt;&lt;span class=&quot;base&quot;&gt;&lt;span class=&quot;strut&quot;&gt;&lt;/span&gt;&lt;span class=&quot;mord mathnormal&quot;&gt;v&lt;/span&gt;&lt;span class=&quot;mord&quot;&gt;&lt;span class=&quot;mord mathnormal&quot;&gt;g&lt;/span&gt;&lt;span class=&quot;msupsub&quot;&gt;&lt;span class=&quot;vlist-t vlist-t2&quot;&gt;&lt;span class=&quot;vlist-r&quot;&gt;&lt;span class=&quot;vlist&quot;&gt;&lt;span class=&quot;pstrut&quot;&gt;&lt;/span&gt;&lt;span class=&quot;sizing reset-size6 size3 mtight&quot;&gt;&lt;span class=&quot;mord mtight&quot;&gt;0&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span class=&quot;vlist-s&quot;&gt;​&amp;nbsp; = d = 1&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;br&gt;&lt;/font&gt;&lt;p data-start=&quot;1217&quot; data-end=&quot;1276&quot;&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;These allow Falcon to &lt;strong data-start=&quot;1239&quot; data-end=&quot;1262&quot;&gt;construct F₀ and G₀&lt;/strong&gt; that satisfy:&lt;/font&gt;&lt;/p&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;&lt;br&gt;&lt;span class=&quot;katex-display&quot;&gt;&lt;span class=&quot;katex&quot;&gt;&lt;span class=&quot;katex-mathml&quot;&gt;&lt;math xmlns=&quot;http://www.w3.org/1998/Math/MathML&quot; display=&quot;block&quot;&gt;&lt;mrow&gt;&lt;msub&gt;&lt;mi&gt;f&lt;/mi&gt;&lt;mn&gt;0&lt;/mn&gt;&lt;/msub&gt;&lt;msub&gt;&lt;mi&gt;G&lt;/mi&gt;&lt;mn&gt;0&lt;/mn&gt;&lt;/msub&gt;&lt;mo&gt;−&lt;/mo&gt;&lt;msub&gt;&lt;mi&gt;g&lt;/mi&gt;&lt;mn&gt;0&lt;/mn&gt;&lt;/msub&gt;&lt;msub&gt;&lt;mi&gt;F&lt;/mi&gt;&lt;mn&gt;0&lt;/mn&gt;&lt;/msub&gt;&lt;mo&gt;=&lt;/mo&gt;&lt;mi&gt;q&lt;/mi&gt;&lt;mi&gt;&lt;br&gt;&lt;/mi&gt;&lt;mi&gt;&lt;br&gt;&lt;/mi&gt;&lt;mi&gt;&lt;br&gt;&lt;/mi&gt;&lt;/mrow&gt;f_0 G_0 - g_0 F_0 = q&lt;/math&gt;&lt;/span&gt;&lt;br&gt;&lt;/span&gt;&lt;/span&gt;&lt;/font&gt;" vertex="1">
